{
  "manifest_version": 3,
  "name": "Notiq Autofill",
  "version": "0.3.0",
  "description": "Fill and save logins with your Notiq vault. Nothing leaves your computer; you approve every fill and save inside the Notiq app.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Fill with Notiq",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Fill login with Notiq"
    }
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
